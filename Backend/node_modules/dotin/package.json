{
  "name": "dotin",
  "version": "0.0.1",
  "description": "dotin bundler tools",
  "main": "dist/dotin.js",
  "module": "dist/dotin.es.js",
  "jsnext:main": "dist/dotin.es.js",
  "bin": {
    "dotin": "./bin/dotin"
  },
  "scripts": {
    "build": "rollup -c -f cjs -o dist/dotin.js && rollup -c -o dist/dotin.es.js",
    "dev": "rollup -cw -f cjs -o dist/dotin.js",
    "test": "npm run lint && npm run build && npm run unit",
    "lint": "standard rollup.config.js test/test.js src/** --fix",
    "unit": "cross-env NODE_ENV=production mocha test/test.js",
    "prepublish": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jetsly/dotin.git"
  },
  "author": "diandi",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Jetsly/dotin/issues"
  },
  "homepage": "https://github.com/Jetsly/dotin#readme",
  "devDependencies": {
    "cross-env": "^3.1.3",
    "mocha": "^3.2.0",
    "rollup": "^0.37.0",
    "rollup-plugin-buble": "^0.15.0",
    "standard": "^8.6.0"
  }
}
